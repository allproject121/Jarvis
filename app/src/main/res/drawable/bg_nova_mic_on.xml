<?xml version="1.0" encoding="utf-8"?>
<!-- Nova dock: raised mic button, accent core with a soft glow ring. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/themeAccentLight" />
                </shape>
            </item>
            <item
                android:top="5dp"
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="?attr/themeAccent"
                        android:endColor="?attr/themeAccent2" />
                </shape>
            </item>
            <!-- Deepens the core a little so the white mic icon keeps at least 3:1 contrast. -->
            <item
                android:top="5dp"
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp">
                <shape android:shape="oval">
                    <solid android:color="#2E000000" />
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
