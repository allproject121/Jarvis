<?xml version="1.0" encoding="utf-8"?>
<!-- Bento pill badge (pair with a coloured dot): plate fill + plate hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="?attr/themeChipBg" />
    <stroke
        android:width="1dp"
        android:color="?attr/themePlateBorder" />
</shape>
