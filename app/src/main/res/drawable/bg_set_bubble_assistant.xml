<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant chat bubble: subtle glass, 16dp radius (tail corner 6dp), hairline border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomRightRadius="16dp"
        android:bottomLeftRadius="6dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="?attr/themeCardGlassStart"
        android:endColor="?attr/themeCardGlassEnd" />
    <stroke
        android:width="1dp"
        android:color="?attr/themeCardBorder" />
</shape>
