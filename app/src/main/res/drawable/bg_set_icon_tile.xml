<?xml version="1.0" encoding="utf-8"?>
<!-- 36dp icon tile: accent-tinted plate with plate hairline (icon tint = themeAccent). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="?attr/themeAccentLight" />
    <stroke
        android:width="1dp"
        android:color="?attr/themePlateBorder" />
</shape>
