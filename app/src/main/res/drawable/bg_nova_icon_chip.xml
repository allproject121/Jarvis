<?xml version="1.0" encoding="utf-8"?>
<!-- Nova home: accent-tinted icon plate (icon tint = themeAccent). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="?attr/themeAccentLight" />
    <stroke
        android:width="1dp"
        android:color="?attr/themePlateBorder" />
</shape>
