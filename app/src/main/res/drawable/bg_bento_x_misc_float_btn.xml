<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento floating icon button (2026-11-05 bento-all) for chrome over full-screen
     WebViews (God's Eye globe): solid card fill so it reads over any map, 12dp, plate hairline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/themeCardBg" />
            <stroke
                android:width="1dp"
                android:color="?attr/themePlateBorder" />
        </shape>
    </item>
</ripple>
