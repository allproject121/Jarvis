<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Frosted dynamic glass dock base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="?attr/themeDockGlassStart"
                android:centerColor="?attr/themeDockBg"
                android:endColor="?attr/themeDockGlassEnd" />
            <stroke
                android:width="1.4dp"
                android:color="?attr/themeDockBorder" />
        </shape>
    </item>

    <!-- Layer 2: Theme Energy Top Beam -->
    <item
        android:top="1dp"
        android:left="24dp"
        android:right="24dp"
        android:height="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="?attr/themeGlassSpecular"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Apple-style Top Specular Glass Sheen -->
    <item
        android:top="2dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="34dp"
                android:topRightRadius="34dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
