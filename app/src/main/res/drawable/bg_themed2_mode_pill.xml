<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-following variant of bg_jarvis_mode_pill (accent gradient pill). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="?attr/themeAccent1"
        android:endColor="?attr/themeAccent2"
        android:type="linear" />
    <corners android:radius="24dp" />
    <padding
        android:left="14dp"
        android:top="6dp"
        android:right="14dp"
        android:bottom="6dp" />
</shape>
