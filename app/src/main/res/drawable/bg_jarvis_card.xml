<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento card (2026-11-05) - shared Jarvis card: theme fill with a lighter top edge,
     soft corner glow, 1dp hairline. Colours are theme attrs only, so light themes get white cards + grey hairline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="?attr/themeCardGlassStart"
                        android:endColor="?attr/themeCardGlassEnd" />
                </shape>
            </item>
            <!-- soft corner glow (very faint on light themes) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:type="radial"
                        android:centerX="1.0"
                        android:centerY="0.0"
                        android:gradientRadius="95%"
                        android:startColor="?attr/themeGlow1"
                        android:endColor="@android:color/transparent" />
                </shape>
            </item>
            <!-- 1dp hairline -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/themeCardBorder" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
