<?xml version="1.0" encoding="utf-8"?>
<!-- Nova dock: floating glass pill with a hairline border and a faint top highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?attr/themeDockGlassStart"
                android:endColor="?attr/themeDockGlassEnd" />
            <stroke
                android:width="1dp"
                android:color="?attr/themeDockBorder" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="28dp"
        android:right="28dp"
        android:height="1dp"
        android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
