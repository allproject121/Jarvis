<?xml version="1.0" encoding="utf-8"?>
<!-- Maya card: 20dp radius, theme surface, hairline border. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="?attr/themeCardBg" />
            <stroke android:width="1dp" android:color="?attr/themeCardBorder" />
        </shape>
    </item>
</ripple>
