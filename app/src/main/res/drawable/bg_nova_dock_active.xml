<?xml version="1.0" encoding="utf-8"?>
<!-- Nova dock: active tab = glass pill with a hairline border (works on light and dark themes). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="@color/nova_dock_active_fill" />
    <stroke
        android:width="1dp"
        android:color="?attr/themeCardBorder" />
</shape>
