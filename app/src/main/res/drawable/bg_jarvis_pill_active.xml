<?xml version="1.0" encoding="utf-8"?>
<!-- Active filter pill / segmented tab.
     Fill = ?attr/themeAccentFill; label/icon MUST use ?attr/themeOnAccent
     (ThemeManager.onAccentColor(ctx) in code) so text never matches the button. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_accent">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/themeAccentFill" />
        </shape>
    </item>
</ripple>
