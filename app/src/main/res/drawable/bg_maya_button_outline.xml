<?xml version="1.0" encoding="utf-8"?>
<!-- Maya secondary/ghost button: plate fill + hairline; label = themeTextPrimary. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/themeChipBg" />
            <stroke
                android:width="1dp"
                android:color="?attr/themePlateBorder" />
        </shape>
    </item>
</ripple>
