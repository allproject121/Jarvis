<?xml version="1.0" encoding="utf-8"?>
<!-- Nova dock: raised mic button while the mic is muted (red core + red glow ring). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#33EF4444" />
                </shape>
            </item>
            <item
                android:top="5dp"
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#EF4444"
                        android:endColor="#B91C1C" />
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
