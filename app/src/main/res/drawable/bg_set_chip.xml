<?xml version="1.0" encoding="utf-8"?>
<!-- Bento outline pill chip with ripple (composer chips, follow-ups). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="?attr/themeChipBg" />
            <stroke
                android:width="1dp"
                android:color="?attr/themePlateBorder" />
        </shape>
    </item>
</ripple>
