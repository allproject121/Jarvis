<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento card (2026-11-05) - action tile, second glow from the top-left: theme fill with a lighter top edge,
     soft corner glow, 1dp hairline. Colours are theme attrs only, so light themes get white cards + grey hairline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="?attr/themeCardGlassStart"
                        android:endColor="?attr/themeCardGlassEnd" />
                </shape>
            </item>
            <!-- top light-catch sheen (white 8% -> 0; invisible on white light-theme cards) -->
            <item
                android:gravity="top"
                android:height="64dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="20dp"
                        android:topRightRadius="20dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#14FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <!-- soft corner glow (very faint on light themes) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:type="radial"
                        android:centerX="0.0"
                        android:centerY="0.0"
                        android:gradientRadius="120%"
                        android:startColor="?attr/themeGlow2"
                        android:endColor="@android:color/transparent" />
                </shape>
            </item>
            <!-- 1dp hairline -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/themeCardBorder" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
