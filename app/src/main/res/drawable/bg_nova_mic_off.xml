<?xml version="1.0" encoding="utf-8"?>
<!-- Nova dock: raised mic button while Jarvis is off (neutral disc). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/themeDockGlassStart" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/themeDockBorder" />
                </shape>
            </item>
            <item
                android:top="5dp"
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/themeChipBg" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/themeCardBorder" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
