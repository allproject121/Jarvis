<?xml version="1.0" encoding="utf-8"?>
<!-- Customization Studio (Dark Bento, 2026-11-05): 42dp section icon plate
     (accent-soft fill + plate hairline, 14dp radius) - same as Media Studio's IconPlate. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="?attr/themeAccentLight" />
    <stroke
        android:width="1dp"
        android:color="?attr/themePlateBorder" />
</shape>
