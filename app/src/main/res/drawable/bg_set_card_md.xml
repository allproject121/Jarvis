<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento card (2026-11-05) - 16dp bars / stat tiles: theme fill with a lighter top edge,
     no glow, 1dp hairline. Colours are theme attrs only, so light themes get white cards + grey hairline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?attr/themeCardGlassStart"
                android:endColor="?attr/themeCardGlassEnd" />
        </shape>
    </item>
    <!-- 1dp hairline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="?attr/themeCardBorder" />
        </shape>
    </item>
</layer-list>
