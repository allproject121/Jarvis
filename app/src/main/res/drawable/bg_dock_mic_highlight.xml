<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Outer Glow Aura -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#26FFFFFF" />
                </shape>
            </item>
            <!-- Arc Reactor Core -->
            <item
                android:top="2dp"
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="?attr/themeAccent"
                        android:centerColor="#0284C7"
                        android:endColor="#0369A1" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
