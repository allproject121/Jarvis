<?xml version="1.0" encoding="utf-8"?>
<!-- Edit API keys dialog body - Dark Bento (2026-11-05 bento-all): label + rounded input plates. Ids unchanged. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Operator Name"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etDialogUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Roshan"
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextMuted"
        android:background="@drawable/bg_bento_x_input"
        android:minHeight="50dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:fontFamily="@font/inter"
        android:textSize="15sp"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gemini Live API Key"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etDialogApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="AIzaSy..."
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextMuted"
        android:background="@drawable/bg_bento_x_input"
        android:minHeight="50dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:fontFamily="@font/inter"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YouTube Data / OpenAI API Key (Optional)"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etDialogYoutubeKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Optional API key"
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextMuted"
        android:background="@drawable/bg_bento_x_input"
        android:minHeight="50dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:fontFamily="@font/inter"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="textPassword"
        android:layout_marginBottom="8dp" />

</LinearLayout>
