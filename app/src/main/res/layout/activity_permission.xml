<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="40dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_set_icon_btn"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permissions"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="26sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="System access &amp; privacy control"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_nova_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_jarvis_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Jarvis Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Jarvis · Neural Assistant"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Grant necessary authorizations so Jarvis can listen, speak, deliver accurate weather, and process your requests seamlessly."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Card 1: Microphone -->
            <LinearLayout
                android:id="@+id/cardMicPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_nova_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_set_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_mic_jarvis"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Microphone access"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvStatusMic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Checking..."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantMic"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Grant"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="?attr/themeOnAccent" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/inter"
                    android:text="Required for voice conversations, voice recognition, and real-time audio interaction with Jarvis."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Card 2: Location -->
            <LinearLayout
                android:id="@+id/cardLocationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_nova_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_set_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_weather_sun"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Precise location"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvStatusLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Checking..."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Grant"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="?attr/themeOnAccent" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/inter"
                    android:text="Required to detect your exact city/locality and provide accurate real-time weather and temperature reports on Home screen."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Card 3: Notification -->
            <LinearLayout
                android:id="@+id/cardNotificationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_nova_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_set_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_nav_bell"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notifications"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvStatusNotification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Checking..."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Grant"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="?attr/themeOnAccent" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/inter"
                    android:text="Required for reminders, schedule alerts, and continuous background voice service notifications."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Card 4: System Overlay -->
            <LinearLayout
                android:id="@+id/cardOverlayPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_nova_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_set_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Display over other apps"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvStatusOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Checking..."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Grant"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="?attr/themeOnAccent" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/inter"
                    android:text="Optional: Allows Jarvis floating bubble to appear anywhere on your phone for quick one-tap voice commands."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Card 5: Accessibility Service -->
            <LinearLayout
                android:id="@+id/cardAccessibilityPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_nova_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_set_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_checklist_tasks"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accessibility service"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvStatusAccessibility"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Checking..."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Grant"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_jarvis_pill_button"
                        android:textColor="?attr/themeOnAccent" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/inter"
                    android:text="Essential for autonomous AI actions: allows Jarvis to tap buttons, search apps, type messages, and scroll hands-free on your screen."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Bottom Action Buttons -->
            <Button
                android:id="@+id/btnGrantAll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Grant all permissions"
                android:textAllCaps="false"
                android:textColor="?attr/themeOnAccent"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:background="@drawable/bg_jarvis_pill_button"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="Open system app settings"
                android:textAllCaps="false"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                app:backgroundTint="?attr/themeChipBg"
                app:strokeColor="?attr/themePlateBorder"
                app:strokeWidth="1dp"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
