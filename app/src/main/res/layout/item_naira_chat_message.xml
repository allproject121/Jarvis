<?xml version="1.0" encoding="utf-8"?>
<!-- JarvisChatAdapter message row - Dark Bento pass 2026-11-05 (bento-all, backup backups/bento-all-2026-11-05):
     accent-tinted user bubble right, glass bento assistant bubble left (no neon accent bar), Inter type,
     ghost circular action icons. Ids and view types unchanged. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- User message (right) -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingStart="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:background="@drawable/bg_bento_x_chat_bubble_user"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="Hi"
            android:textColor="?attr/themeTextPrimary"
            android:fontFamily="@font/inter"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnUserEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_edit"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Edit" />

            <ImageView
                android:id="@+id/btnUserCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy" />
        </LinearLayout>
    </LinearLayout>

    <!-- Assistant message (left) -->
    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="310dp"
            android:background="@drawable/bg_bento_x_chat_bubble_ai"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Hey! I'm doing great, aap. How are you feeling today?"
            android:textColor="?attr/themeTextPrimary"
            android:fontFamily="@font/inter"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnAssistantCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy" />

            <ImageView
                android:id="@+id/btnAssistantPlay"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_tts_play"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Play" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
