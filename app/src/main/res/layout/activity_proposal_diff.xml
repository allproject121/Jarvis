<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento layout (2026-11-05 bento-all): page header, security-gate bento card with status pill,
     diff viewer inside a rounded card (monospace + diff syntax colours kept). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/proposalDiffRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/themeBg">

    <!-- Header: ghost back + page title / muted subtitle + copy -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_set_icon_btn"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvProposalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proposal diff"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="24sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvProposalSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Feature review"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCopyDiff"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_set_icon_btn"
            android:src="@drawable/ic_copy"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Copy complete diff" />
    </LinearLayout>

    <!-- Security gate: bento card -->
    <LinearLayout
        android:id="@+id/layoutSecurityBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:background="@drawable/bg_jarvis_card"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING_USER_APPROVAL"
                android:textColor="?attr/themeWarning"
                android:fontFamily="@font/inter"
                android:textFontWeight="500"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:drawableStart="@drawable/bg_bento_dot"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_set_badge" />

            <TextView
                android:id="@+id/tvFileStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:text="6 files • 445 lines"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Security gate: code changes are not applied until you explicitly approve them via apply_integration_proposal."
            android:textColor="?attr/themeTextMuted"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:lineSpacingMultiplier="1.15" />
    </LinearLayout>

    <!-- Diff viewer inside a rounded card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_set_card_md"
        android:padding="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="horizontal">

                <TextView
                    android:id="@+id/tvDiffContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="?attr/themeTextSecondary"
                    android:padding="16dp"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="2dp" />
            </HorizontalScrollView>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
