<?xml version="1.0" encoding="utf-8"?>
<!-- AI Persona - Dark Bento layout (2026-11-05 bento-all): page title + subtitle, profile bento card,
     persona bento cards (icon plate + pill + 18sp title), name + voice sections as bento cards with
     rounded inner plates (8dp gaps) instead of hairline dividers. All ids/types unchanged. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_set_icon_btn"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Persona"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="26sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose your companion personality"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollPersona"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:descendantFocusability="beforeDescendants"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Operator profile bento card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_nova_card"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your operator profile"
                    android:singleLine="true"
                        android:maxLines="1"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:background="@drawable/bg_set_badge"
                        android:drawableStart="@drawable/bg_bento_dot"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                <TextView
                    android:id="@+id/tvPersonaPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Jarvis Pro · Charon"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="22sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/tvPersonaGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ready to help, Roshan."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPersonaJarvis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_set_icon_tile">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_home"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Jarvis" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default AI"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:background="@drawable/bg_set_badge"
                        android:drawableStart="@drawable/bg_bento_dot"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Jarvis Pro"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Intelligent, witty &amp; strategic assistant by Roshan"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rbSelectJarvis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:buttonTint="?attr/themeAccent"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPersonaGirlfriend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_set_icon_tile">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_chat"
                        app:tint="?attr/themeAccent2"
                        android:contentDescription="Girlfriend" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sweet"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:background="@drawable/bg_set_badge"
                        android:drawableStart="@drawable/bg_bento_dot"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Girlfriend Mode (Pari)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Caring, warm, affectionate Hinglish companion"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rbSelectGirlfriend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:buttonTint="?attr/themeAccent"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPersonaBoyfriend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_set_icon_tile">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_shield"
                        app:tint="?attr/themeInfo"
                        android:contentDescription="Boyfriend" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Charming"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:background="@drawable/bg_set_badge"
                        android:drawableStart="@drawable/bg_bento_dot"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Boyfriend Mode (Kabir)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Charismatic, protective &amp; supportive partner"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rbSelectBoyfriend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:buttonTint="?attr/themeAccent"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPersonaRoshan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingStart="18dp"
                android:paddingEnd="10dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_set_icon_tile">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_code_chip"
                        app:tint="?attr/themeSuccess"
                        android:contentDescription="Roshan Mode" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Neural core"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:background="@drawable/bg_set_badge"
                        android:drawableStart="@drawable/bg_bento_dot"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Roshan Mode"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ultra-fast code architecture, research &amp; deep reasoning"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/rbSelectRoshan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:buttonTint="?attr/themeAccent"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Your name bento card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_set_icon_tile">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_chat"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="@null" />
                </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your name"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How this persona addresses you (default: Roshan)"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="?attr/themeInputBg"
                    app:boxStrokeWidth="1dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="?attr/themeAccent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Roshan"
                        android:text="Roshan"
                        android:inputType="textPersonName"
                        android:textColor="?attr/themeTextPrimary"
                        android:textColorHint="?attr/themeTextMuted"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Voice tone bento card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_set_icon_tile">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_shield"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="@null" />
                </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voice tone"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live voice used by this persona"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/rgVoiceGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbVoiceAoede"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="52dp"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="Aoede (Warm, expressive female voice)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        app:buttonTint="?attr/themeAccent" />

                    <RadioButton
                        android:id="@+id/rbVoiceKore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="52dp"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="Kore (Gentle, calm female voice)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        app:buttonTint="?attr/themeAccent" />

                    <RadioButton
                        android:id="@+id/rbVoiceFenrir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="52dp"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="Fenrir (Deep, protective charismatic male voice)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        app:buttonTint="?attr/themeAccent" />

                    <RadioButton
                        android:id="@+id/rbVoicePuck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="52dp"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="Puck (Crisp, modern dynamic male voice)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        app:buttonTint="?attr/themeAccent" />

                    <RadioButton
                        android:id="@+id/rbVoiceCharon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="52dp"
                        android:background="@drawable/bg_jarvis_row_item"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:text="Charon (Distinguished butler male voice)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        app:buttonTint="?attr/themeAccent" />

                </RadioGroup>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom action bar -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="?attr/themeBg"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivatePersona"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_jarvis_pill_button"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Activate persona"
            android:textColor="?attr/themeOnAccent"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
