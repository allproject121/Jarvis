<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento theme picker sheet (2026-11-05 bento-all): page title + muted subtitle,
     "App themes" bento card with theme rows as inner plates, "Custom colour" bento card. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bento_x_sheet"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bento_x_handle"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Theme"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="26sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:letterSpacing="-0.02" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restyles the entire app and the neural orb."
        android:textColor="?attr/themeTextMuted"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== App themes card ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_set_card"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_set_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_settings_palette"
                        android:contentDescription="@null"
                        app:tint="?attr/themeAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App themes"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Every screen follows the theme you pick"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Theme: Nova -->
                <LinearLayout
                    android:id="@+id/cardThemeNova"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#A78BFA"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nova (new look)"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Zinc black · violet glow · Inter"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckNova"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: Light -->
                <LinearLayout
                    android:id="@+id/cardThemeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#F4F6FB"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Light"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Crisp studio white · blue &amp; violet accents"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckLight"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: Dark -->
                <LinearLayout
                    android:id="@+id/cardThemeDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#0A0D1F"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dark"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Deep midnight · cyan &amp; purple accents"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckDark"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: Red -->
                <LinearLayout
                    android:id="@+id/cardThemeRed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#2A0A10"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Red"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Obsidian crimson · Laser coral &amp; flame"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckRed"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: Sunset -->
                <LinearLayout
                    android:id="@+id/cardThemeSunset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#FFE7E1"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunset"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Warm pastel peach · Coral &amp; magenta twilight"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckSunset"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: Stealth OLED -->
                <LinearLayout
                    android:id="@+id/cardThemeStealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#000000"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stealth OLED Black"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pure pitch black · Minimalist silver glass specular"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckStealth"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: AndroLLM Night -->
                <LinearLayout
                    android:id="@+id/cardThemeAndroNight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#7A5CFF"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AndroLLM Night"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Blackout desk · Aurora violet accent"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckAndroNight"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: AndroLLM Parchment -->
                <LinearLayout
                    android:id="@+id/cardThemeAndroParchment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#D97757"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AndroLLM Parchment"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Daylight parchment · Terracotta ink"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckAndroParchment"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Theme: Maya -->
                <LinearLayout
                    android:id="@+id/cardThemeMaya"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:minHeight="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="@color/maya_primary"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maya"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Charcoal-navy · electric blue · character stage on Home"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckMaya"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Custom colour card ===== -->
            <LinearLayout
                android:id="@+id/cardThemeCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_set_card"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewCustomPreview"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_bento_x_sht_swatch"
                        android:backgroundTint="#8B5CF6"
                        android:foreground="@drawable/bg_bento_x_sht_swatch_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom colour"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:id="@+id/tvCustomSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Choose any HEX colour (#RRGGBB)"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivCheckCustom"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/bg_bento_x_sht_check"
                        android:contentDescription="Selected"
                        app:tint="?attr/themeAccent" />
                </LinearLayout>

                <!-- Hex input + Apply -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <EditText
                        android:id="@+id/etCustomHex"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="#1E1B4B"
                        android:text="#1E1B4B"
                        android:textColor="?attr/themeTextPrimary"
                        android:textColorHint="?attr/themeTextMuted"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_bento_x_input"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="88dp"
                        android:text="Apply"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
