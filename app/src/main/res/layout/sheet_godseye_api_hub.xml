<?xml version="1.0" encoding="utf-8"?>
<!-- God's Eye sensors & API hub sheet - Dark Bento layout (2026-11-05 bento-all).
     Every android:id and view type is unchanged (GodsEyeApiHubBottomSheet binds them). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bento_x_sheet"
    android:paddingTop="10dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bento_x_handle"
        android:layout_marginBottom="14dp" />

    <!-- Header: title + muted subtitle, ghost close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensors &amp; API hub"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="26sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Live feeds you can pull straight onto the globe"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHubClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_set_icon_btn"
            android:src="@drawable/ic_close"
            android:scaleType="fitCenter"
            android:padding="11dp"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Close Hub" />
    </LinearLayout>

    <!-- Scrollable sections -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== 0. Sentinel tour ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:padding="10dp"
                        android:src="@drawable/ic_auto_cycle"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Auto Patrol" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sentinel tour"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-cycles every live layer"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleAutoTourHub"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Start"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeOnAccent"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        app:backgroundTint="?attr/themeAccentFill"
                        app:cornerRadius="22dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Flies through flights, live CCTV, earthquakes, space launches and storms on its own."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <!-- ===== 1. Rocket launches ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="🚀"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rocket launches"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Launch Library 2 · v2.3"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Upcoming SpaceX, ISRO, NASA and ESA missions with countdowns and pads."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />

                <Button
                    android:id="@+id/btnConnectLaunches"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="Fetch launches"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeOnAccent"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:background="@drawable/bg_jarvis_pill_button"
                    app:backgroundTint="@null" />

                <ProgressBar
                    android:id="@+id/pbLaunches"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/themeAccent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerLaunches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ===== 2. Live radio ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="📻"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live radio"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30,000+ stations worldwide"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Stream broadcast stations from around the world."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />

                <!-- Now-playing bar (shown while a station plays) -->
                <LinearLayout
                    android:id="@+id/layoutRadioPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCurrentPlayingStation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Playing: ..."
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:drawableStart="@drawable/bg_bento_dot"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <Button
                        android:id="@+id/btnStopRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="Stop"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeDanger"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_set_chip"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <Button
                        android:id="@+id/btnConnectRadioGlobal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="Global"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:background="@drawable/bg_set_chip"
                        app:backgroundTint="@null"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnConnectRadioIndia"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="India"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:background="@drawable/bg_set_chip"
                        app:backgroundTint="@null"
                        android:layout_marginHorizontal="4dp" />

                    <Button
                        android:id="@+id/btnConnectRadioAmbient"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="Ambient"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:background="@drawable/bg_set_chip"
                        app:backgroundTint="@null"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbRadio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/themeAccent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ===== 3. Aircraft lookup ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="✈️"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aircraft lookup"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registration and route · ADSBdb"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Decode the airframe, owner / operator and route from a callsign or hex code."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <EditText
                        android:id="@+id/etAircraftQuery"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Callsign (AIC101) or hex (800b4a)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textColorHint="?attr/themeTextMuted"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:background="@drawable/bg_bento_x_input"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:inputType="textCapCharacters" />

                    <Button
                        android:id="@+id/btnLookupAircraft"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Look up"
                        android:textAllCaps="false"
                        android:textColor="?attr/themeOnAccent"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_jarvis_pill_button"
                        app:backgroundTint="@null"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbAircraft"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/themeAccent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAircraftResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== 4. Tropical cyclones ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="🌀"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tropical cyclones"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOAA NHC / CPHC"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Active hurricanes and cyclones with central pressure and wind intensity."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />

                <Button
                    android:id="@+id/btnConnectCyclones"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="Scan active cyclones"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeOnAccent"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:background="@drawable/bg_jarvis_pill_button"
                    app:backgroundTint="@null" />

                <ProgressBar
                    android:id="@+id/pbCyclones"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/themeAccent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCyclonesResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== 5. GDELT geo-intel ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="🌐"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Geo-intel news"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GDELT 2.0 · real time"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="News and security events from thousands of international sources."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />

                <Button
                    android:id="@+id/btnConnectNews"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="Pull geo-intel"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeOnAccent"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:background="@drawable/bg_jarvis_pill_button"
                    app:backgroundTint="@null" />

                <ProgressBar
                    android:id="@+id/pbNews"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/themeAccent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerNews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ===== 6. Live CCTV ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="📹"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live CCTV"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verified street and highway cameras"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Pick a camera to fly the globe there and project its live frame."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />

                <LinearLayout
                    android:id="@+id/containerCctvPresets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
