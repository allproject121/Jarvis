<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento API hub sheet (2026-11-05 bento-all): sheet surface + handle, page title + muted subtitle,
     pill chips (checked state styled in ApiRegistryBottomSheet), input plate, card list. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bento_x_sheet"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bento_x_handle" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTotalApiCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_set_badge"
                android:drawableStart="@drawable/bg_bento_dot"
                android:drawablePadding="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="24 feeds"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API hub"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="26sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Live data feeds, endpoints &amp; ping tests"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <!-- Test All Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPingAllApis"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="Ping all"
            android:textAllCaps="false"
            android:textColor="?attr/themeOnAccent"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            app:backgroundTint="?attr/themeAccentFill"
            app:cornerRadius="21dp" />
    </LinearLayout>

    <!-- Category Filter Chips (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:checked="true"
                android:text="All (24)"
                android:textColor="?attr/themeOnAccent"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeAccentFill"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAviation"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Aviation"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCctv"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="CCTV"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSpace"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Space"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeather"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Weather"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSeismic"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Seismic"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDefense"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Defense"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAudio"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Audio"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themePlateBorder"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Search / Filter Box -->
    <EditText
        android:id="@+id/etSearchApis"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_bento_x_input"
        android:hint="Search APIs by name, domain or keyword"
        android:textColorHint="?attr/themeTextMuted"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:paddingHorizontal="14dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableTint="?attr/themeTextMuted"
        android:drawablePadding="10dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- RecyclerView for API items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
