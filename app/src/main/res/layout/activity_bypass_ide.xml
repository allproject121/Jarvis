<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento layout (2026-11-05 bento-all): page title + muted subtitle, telemetry bento card with
     metric plates, pill segmented tabs (active = bg_bento_x_chip_on, idle = bg_set_chip; swapped in
     BypassIdeActivity.switchSubTab), terminal card (monospace kept), pill quick actions. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootBypassIde"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/themeBg">

    <!-- 1. HEADER -->
    <LinearLayout
        android:id="@+id/topBarBypassIde"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_set_icon_btn"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bypass IDE"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="26sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:letterSpacing="-0.02"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pro"
                    android:textColor="?attr/themeAccent"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:background="@drawable/bg_set_badge_accent"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autonomous agentic studio · v5.2"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Status pill (tap to cycle) -->
        <LinearLayout
            android:id="@+id/pillDynamicIsland"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_set_badge"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/dotIslandGlow"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_bento_dot" />

            <TextView
                android:id="@+id/tvIslandStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="500"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. TELEMETRY BENTO CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_jarvis_card"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:padding="16dp">

        <!-- AI engine mode selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI brain"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="16sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/btnAiEngineSelector"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Mode: single (Gemini) ▾"
                android:textColor="?attr/themeOnAccent"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:background="@drawable/bg_bento_x_chip_on"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device telemetry"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/tvBypassSecurityTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking…"
                android:textColor="?attr/themeSuccess"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="500"
                android:maxWidth="230dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:background="@drawable/bg_set_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- 3 metric plates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/tvTeleArcCore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85%"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                android:layout_marginHorizontal="4dp">

                <TextView
                    android:id="@+id/tvTeleEdgeRam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free RAM"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/tvTeleProvider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI provider"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. SEGMENTED PILL TABS -->
    <LinearLayout
        android:id="@+id/rowSegmentedTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tabShell"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Shell"
            android:textColor="?attr/themeOnAccent"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:background="@drawable/bg_bento_x_chip_on"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tabAgents"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Agents"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:background="@drawable/bg_set_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 4. MAIN CONTENT VIEWPORT -->
    <FrameLayout
        android:id="@+id/viewportContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- ==================== VIEW 1: SHELL ==================== -->
        <LinearLayout
            android:id="@+id/panelShellView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Terminal card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_set_icon_tile">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_code_chip"
                            app:tint="?attr/themeAccent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terminal"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Command log"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="Clear"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:background="@drawable/bg_set_chip"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Terminal window on an inner plate -->
                <ScrollView
                    android:id="@+id/scrollTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="12dp"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/tvTerminalOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:textIsSelectable="true"
                        tools:text="[18:49:01] JARVIS Mobile Core initialized.\n[18:49:02] Accessibility: ON" />
                </ScrollView>
            </LinearLayout>

            <!-- Quick action pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipMacroWhatsapp"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:text="Open WhatsApp"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:background="@drawable/bg_set_chip"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipMacroRoot"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:text="Root check"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:background="@drawable/bg_set_chip"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipMacroDualBrain"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center_vertical"
                        android:text="AI status"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:background="@drawable/bg_set_chip"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Command input field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_bento_x_input"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ "
                    android:textColor="?attr/themeAccent"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTerminalInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Type help, status, scan, ask…"
                    android:textColorHint="?attr/themeTextMuted"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:imeOptions="actionSend"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/btnRunCommand"
                    android:layout_width="68dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Run"
                    android:textColor="?attr/themeOnAccent"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:background="@drawable/bg_jarvis_pill_button"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== VIEW 2: AGENTS ==================== -->
        <ScrollView
            android:id="@+id/panelAgentsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agents"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What runs behind the shell"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginBottom="14dp" />

                <!-- Agent 1: Dual-brain AI router -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="🧠"
                        android:textSize="17sp"
                        android:background="@drawable/bg_set_icon_tile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dual-brain AI router"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:id="@+id/tvRouterAgentDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last provider used: —"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Agent 2: Accessibility SuperCore -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="♿"
                        android:textSize="17sp"
                        android:background="@drawable/bg_set_icon_tile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accessibility SuperCore"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Autonomous touch injection &amp; humanized typing"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAccessAgentStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="?attr/themeSuccess"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:background="@drawable/bg_set_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <!-- Agent 3: God's Eye recon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="🛰️"
                        android:textSize="17sp"
                        android:background="@drawable/bg_set_icon_tile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="God's Eye geospatial recon"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cesium 3D globe, OpenSky flights &amp; live CCTV streams"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
