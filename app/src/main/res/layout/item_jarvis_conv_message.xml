<?xml version="1.0" encoding="utf-8"?>
<!--
  One chat message in Jarvis' Chat tab (ChatTabMessageAdapter) - 2026-11-05 redesign.
  Assistant: small "Jarvis" label + subtle glass bubble (bg_set_bubble_assistant, hairline border).
  User: accent-tinted bubble on the right (bg_set_bubble_user). Ghost action icons below each
  bubble, muted 11sp timestamp in tvAssistantMeta. Markdown replies render in
  composeAssistantMarkdown inside the same assistant bubble. All ids unchanged.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMessageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ==================== User message (right) ==================== -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingStart="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserAttachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_set_badge"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:drawableStart="@drawable/ic_jchat_attach"
            android:drawablePadding="6dp"
            android:drawableTint="?attr/themeTextSecondary"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="12sp"
            android:fontFamily="@font/inter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:background="@drawable/bg_set_bubble_user"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="false" />

        <LinearLayout
            android:id="@+id/layoutUserActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivUserBookmarked"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_jchat_bookmark_filled"
                app:tint="?attr/themeAccent"
                android:contentDescription="Bookmarked"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnUserEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_edit"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Edit" />

            <ImageView
                android:id="@+id/btnUserCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy" />

            <ImageView
                android:id="@+id/btnUserMore"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_jchat_more"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="More" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== Assistant message (left) ==================== -->
    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:visibility="gone">

        <!-- Identity label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_set_icon_tile">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkle"
                    app:tint="?attr/themeAccent"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Jarvis"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />
        </LinearLayout>

        <!-- Plain replies -->
        <TextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="310dp"
            android:background="@drawable/bg_set_bubble_assistant"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="3dp" />

        <!-- Markdown replies (code blocks with copy, tables, lists, safe links) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeAssistantMarkdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_set_bubble_assistant"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutAssistantActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnAssistantCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy" />

            <ImageView
                android:id="@+id/btnAssistantPlay"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_tts_play"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Play" />

            <ImageView
                android:id="@+id/btnAssistantRegenerate"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_jchat_refresh"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Regenerate"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnAssistantBookmark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_jchat_bookmark"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Bookmark" />

            <ImageView
                android:id="@+id/btnAssistantShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_jchat_share"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Share" />

            <ImageView
                android:id="@+id/btnAssistantMore"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_jchat_more"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="More" />

            <TextView
                android:id="@+id/tvAssistantMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Follow-up suggestion chips (shown under the latest reply; chips built in code) -->
    <HorizontalScrollView
        android:id="@+id/scrollFollowUps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutFollowUps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

</LinearLayout>
