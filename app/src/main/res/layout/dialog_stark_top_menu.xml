<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_menu_glass"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="18dp"
    android:elevation="36dp">

    <!-- Stark HUD Command Visor Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_jarvis_icon_square">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings_orb"
                    app:tint="?attr/themeAccent"
                    android:contentDescription="Menu Logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS PROTOCOLS"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stark Tactical Command Console"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Close button -->
        <ImageButton
            android:id="@+id/btnCloseTopMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            app:tint="?attr/themeTextMuted"
            android:contentDescription="Close Menu" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/themeCardBorder"
        android:layout_marginBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CATEGORY 1: CORE PROTOCOLS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORE PROTOCOLS &amp; TACTICAL"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp" />

            <!-- Item: JARVIS Matrix & Protocols -->
            <LinearLayout
                android:id="@+id/menuItemMatrixHub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_code_chip"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="JARVIS Matrix" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JARVIS Matrix &amp; Protocols"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Macros, Termux, Guardian &amp; Stocks"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- Item: SuperCore & System Control -->
            <LinearLayout
                android:id="@+id/menuItemSuperCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_verified_badge"
                        app:tint="@color/primary_cyan"
                        android:contentDescription="SuperCore" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SuperCore &amp; System Control"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OS Assistant, WhatsApp Reader &amp; Driving"
                        android:textColor="@color/primary_cyan"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- Item: God's Eye Radar -->
            <LinearLayout
                android:id="@+id/menuItemGodsEye"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_gods_eye"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="God's Eye" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="God's Eye Radar"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perimeter camera &amp; tactical surveillance"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- CATEGORY 2: AI & INTELLIGENCE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI &amp; INTELLIGENCE"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <!-- Item: Chat History -->
            <LinearLayout
                android:id="@+id/menuItemChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat_bubble"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Chat History" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conversation History"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini Live past transcripts &amp; turns"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- Item: Saved Memories -->
            <LinearLayout
                android:id="@+id/menuItemMemories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stack_memory"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Memories" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saved Memories"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Long-term user preferences &amp; RAG facts"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- Item: Voice Biometrics -->
            <LinearLayout
                android:id="@+id/menuItemVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_owner_voice"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Voice Profile" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice Biometrics"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Owner voice security enrollment"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- CATEGORY 3: PREFERENCES & STUDIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREFERENCES &amp; STUDIO"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <!-- Item: Settings & Configuration -->
            <LinearLayout
                android:id="@+id/menuItemSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Settings" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Settings &amp; Config"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI engines, models, security &amp; tools"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- Item: Stark HUD Customization Studio -->
            <LinearLayout
                android:id="@+id/menuItemStudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings_orb"
                        app:tint="?attr/themeAccent"
                        android:contentDescription="Customization Studio" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stark HUD Studio"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Themes, HUD cores &amp; sound FX"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Open" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
