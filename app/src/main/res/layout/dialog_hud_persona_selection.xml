<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_card"
    android:padding="20dp">

    <!-- Header Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEURAL INTELLIGENCE MATRIX"
            android:textColor="?attr/themeAccent"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_jarvis_status_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="?attr/themeCardBorder"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Assistant Persona"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select intelligence personality and voice profile:"
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp"
        android:layout_marginBottom="14dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. JARVIS Companion Mode -->
            <LinearLayout
                android:id="@+id/cardDialogPersonaJarvisCompanion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_jarvis_chip"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_verified_badge"
                    app:tint="?attr/themeAccent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JARVIS Companion Mode"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loving companion &amp; smart secretary • Sweet voice (Aoede)"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeDialogPersonaJarvisCompanion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE"
                    android:textColor="?attr/themeAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_jarvis_status_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- 2. Jarvis Prime -->
            <LinearLayout
                android:id="@+id/cardDialogPersonaJarvis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_jarvis_row_item"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_jarvis_logo"
                    app:tint="?attr/themeAccent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stark J.A.R.V.I.S. (Prime)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="British intelligence • Deep male voice (Puck)"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeDialogPersonaJarvis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE"
                    android:textColor="?attr/themeAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_jarvis_status_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 3. Friday Tactical -->
            <LinearLayout
                android:id="@+id/cardDialogPersonaFriday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_jarvis_row_item"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_settings_voice"
                    app:tint="?attr/themeAccent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="F.R.I.D.A.Y. Tactical"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adaptive defense AI • Female voice (Aoede)"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeDialogPersonaFriday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE"
                    android:textColor="?attr/themeAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_jarvis_status_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 4. Edith Defense -->
            <LinearLayout
                android:id="@+id/cardDialogPersonaEdith"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_jarvis_row_item"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_settings_shield"
                    app:tint="?attr/themeAccent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E.D.I.T.H. Defense System"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Global satellite defense • Confident voice (Charon)"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeDialogPersonaEdith"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE"
                    android:textColor="?attr/themeAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_jarvis_status_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 5. Pari Romantic -->
            <LinearLayout
                android:id="@+id/cardDialogPersonaPari"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_jarvis_row_item"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_settings_secret"
                    app:tint="#F43F5E" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pari (Girlfriend Mode)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sweet, caring &amp; emotional companionship"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeDialogPersonaPari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE"
                    android:textColor="#F43F5E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_jarvis_status_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnDialogClosePersona"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="DISMISS"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_jarvis_row_item"
        android:backgroundTint="@null"
        android:layout_marginTop="16dp" />

</LinearLayout>
