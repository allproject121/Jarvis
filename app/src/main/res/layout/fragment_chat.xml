<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis Chat tab - shadcn / 21st.dev redesign (2026-11-05).
  Top bar: ghost outline icon buttons + centred title, hairline divider. Clean message list
  (bubbles in item_jarvis_conv_message.xml). Composer: model/persona pills above a rounded pill
  input with a ghost paperclip and a circular accent send button. All ids from the previous
  layout are kept (ChatFragment binds them); chatContent padding is set in code (100dp bottom
  clears the floating dock). Backup: backups/settings-chat-redesign-2026-11-05.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/chatContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="100dp">

    <!-- ==================== Top bar ==================== -->
    <ImageButton
        android:id="@+id/btnChatMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_set_icon_btn"
        android:src="@drawable/ic_set_menu"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="Conversations"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingVertical="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="@id/btnChatMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnChatMenu"
        app:layout_constraintStart_toEndOf="@id/btnChatMenu"
        app:layout_constraintEnd_toStartOf="@id/btnChatNew">

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarvis"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="16sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/tvChatSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:text="Online · Gemini Live"
            android:textColor="?attr/themeTextMuted"
            android:textSize="12sp"
            android:fontFamily="@font/inter" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnChatNew"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_set_icon_btn"
        android:src="@drawable/ic_set_square_pen"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:tint="?attr/themeTextPrimary"
        android:contentDescription="New chat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hairline under the top bar -->
    <View
        android:id="@+id/viewChatHeaderDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?attr/themeCardBorder"
        app:layout_constraintTop_toBottomOf="@id/btnChatMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Multi-select action bar (replaces the top bar while messages are selected) -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_set_card_md"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSelectionClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_set_ghost_circle"
            android:src="@drawable/ic_set_x"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Cancel selection" />

        <TextView
            android:id="@+id/tvSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="0 selected"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="500" />

        <ImageButton
            android:id="@+id/btnSelectionCopy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_set_ghost_circle"
            android:src="@drawable/ic_copy"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Copy selected" />

        <ImageButton
            android:id="@+id/btnSelectionShare"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_set_ghost_circle"
            android:src="@drawable/ic_jchat_share"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Share selected" />

        <ImageButton
            android:id="@+id/btnSelectionBookmark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_set_ghost_circle"
            android:src="@drawable/ic_jchat_bookmark"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Bookmark selected" />

        <ImageButton
            android:id="@+id/btnSelectionDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_set_ghost_circle"
            android:src="@drawable/ic_delete"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextSecondary"
            android:contentDescription="Delete selected" />
    </LinearLayout>

    <!-- ==================== Message list ==================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="8dp"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toBottomOf="@id/viewChatHeaderDivider"
        app:layout_constraintBottom_toTopOf="@id/cardInputContainer" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvChatEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp"
        android:background="@drawable/bg_set_card"
        android:text="How can I help today?&#10;&#10;Ask a question, generate code or analyse a file. Tap the paperclip to attach documents."
        android:textColor="?attr/themeTextSecondary"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:lineSpacingExtra="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvChatMessages"
        app:layout_constraintBottom_toBottomOf="@id/rvChatMessages"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ==================== Composer ==================== -->
    <LinearLayout
        android:id="@+id/cardInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Persona / mode pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/chipPersona"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_set_chip"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_nav_chat"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvChipPersona"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jarvis"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="500" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_set_chip"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_code_chip"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvChipMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Code"
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="500" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rounded pill input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_set_composer"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Edit-and-resend banner -->
            <LinearLayout
                android:id="@+id/layoutEditingBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Editing message · sending replaces it and asks Jarvis again"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter" />

                <ImageButton
                    android:id="@+id/btnCancelEditing"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_set_ghost_circle"
                    android:src="@drawable/ic_set_x"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="Cancel editing" />
            </LinearLayout>

            <!-- Pending attachments (PDF / image OCR / Office / text) -->
            <HorizontalScrollView
                android:id="@+id/scrollAttachmentChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutAttachmentChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvAttachmentProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingBottom="6dp"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <!-- Ghost attachment button -->
                <ImageButton
                    android:id="@+id/btnAttach"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_set_ghost_circle"
                    android:src="@drawable/ic_set_paperclip"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:tint="?attr/themeTextSecondary"
                    android:contentDescription="Attach" />

                <EditText
                    android:id="@+id/etMessageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="6dp"
                    android:minHeight="40dp"
                    android:hint="Message Jarvis"
                    android:textColorHint="?attr/themeTextMuted"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:minLines="1"
                    android:maxLines="5"
                    android:inputType="textCapSentences|textMultiLine" />

                <!-- Circular accent send button -->
                <ImageButton
                    android:id="@+id/btnSendMessage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_set_send"
                    android:src="@drawable/ic_set_arrow_up"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:tint="?attr/themeOnAccent"
                    android:contentDescription="Send" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================== Conversation drawer ==================== -->
    <FrameLayout
        android:id="@+id/layoutDrawerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp"
        android:visibility="gone">

        <View
            android:id="@+id/viewDrawerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/panelDrawer"
            android:layout_width="310dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="?attr/themeBg"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDrawerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Conversations"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <ImageButton
                    android:id="@+id/btnDrawerClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_set_icon_btn"
                    android:src="@drawable/ic_set_x"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Close" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_set_search"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_set_search"
                    app:tint="?attr/themeTextMuted"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etDrawerSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Search chats and messages"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="?attr/themeTextPrimary"
                    android:textColorHint="?attr/themeTextMuted"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter" />

                <ImageButton
                    android:id="@+id/btnDrawerSearchClear"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_set_ghost_circle"
                    android:src="@drawable/ic_set_x"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    app:tint="?attr/themeTextMuted"
                    android:visibility="gone"
                    android:contentDescription="Clear search" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipDrawerNewChat"
                        style="@style/JarvisChatDrawerChip"
                        android:background="@drawable/bg_set_chip"
                        android:fontFamily="@font/inter"
                        android:text="+ New chat" />

                    <TextView
                        android:id="@+id/chipDrawerChats"
                        style="@style/JarvisChatDrawerChip"
                        android:background="@drawable/bg_set_chip"
                        android:fontFamily="@font/inter"
                        android:text="Chats" />

                    <TextView
                        android:id="@+id/chipDrawerBookmarks"
                        style="@style/JarvisChatDrawerChip"
                        android:background="@drawable/bg_set_chip"
                        android:fontFamily="@font/inter"
                        android:text="Bookmarks" />

                    <TextView
                        android:id="@+id/chipDrawerArchived"
                        style="@style/JarvisChatDrawerChip"
                        android:background="@drawable/bg_set_chip"
                        android:fontFamily="@font/inter"
                        android:text="Archived" />

                    <TextView
                        android:id="@+id/chipDrawerHome"
                        style="@style/JarvisChatDrawerChip"
                        android:background="@drawable/bg_set_chip"
                        android:fontFamily="@font/inter"
                        android:text="Home" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDrawer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvDrawerEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="Nothing here yet"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/themeCardBorder" />

            <TextView
                android:id="@+id/btnDrawerClearJarvisHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="Clear Jarvis voice history"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
