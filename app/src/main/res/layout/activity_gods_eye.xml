<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGodsEyeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Primary Fullscreen Hardware-Accelerated Cesium WebGL WebView -->
    <WebView
        android:id="@+id/webViewGodsEye"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layerType="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Minimalist Floating Cyber HUD Back Button (Beside title logo; never obscures title bar or top actions) -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="58dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_godseye_hud_back"
        android:src="@drawable/ic_back"
        android:padding="7dp"
        app:tint="#00D4FF"
        android:contentDescription="Return to JARVIS"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Hidden reload button for programmatic / legacy access -->
    <ImageButton
        android:id="@+id/btnReload"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Cyber HUD Loading State Overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_godseye_hud_card"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="#00D4FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTING TO GOD'S EYE..."
            android:textColor="#00D4FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading Cesium 3D Globe &amp; HUD layers"
            android:textColor="#88AACC"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Cyber HUD Error & Recovery Card Overlay -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_godseye_hud_card"
        android:padding="22dp"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_warning"
            app:tint="#FF3B30"
            android:contentDescription="Server Offline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="God's Eye Console Offline"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Could not connect to http://localhost:4173/.\n\nPlease ensure the background server is running in Termux:\ncd ~/gods-eye-view\nnpm run preview -- --host localhost --port 4173"
            android:textColor="#88AACC"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnErrorBack"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="BACK"
                android:textColor="#00D4FF"
                android:background="@drawable/bg_godseye_hud_card"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="RETRY"
                android:textColor="#000000"
                android:background="@drawable/bg_godseye_hud_card"
                android:backgroundTint="#00D4FF"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
