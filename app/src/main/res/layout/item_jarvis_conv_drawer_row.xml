<?xml version="1.0" encoding="utf-8"?>
<!-- Row of the Chat tab conversation drawer: a conversation, a search hit or a section label.
     Dark Bento pass 2026-11-05 (bento-all): rounded inner plate rows with 8dp gaps, sentence-case section
     labels (no caps/tracking); the active conversation gets bg_bento_x_chat_row_active in code. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvDrawerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="16dp"
        android:paddingBottom="2dp"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutDrawerItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_jarvis_row_item"
        android:minHeight="56dp"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="6dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDrawerItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/tvDrawerItemSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivDrawerItemPin"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_jchat_pin"
            app:tint="?attr/themeAccent"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnDrawerItemMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:src="@drawable/ic_jchat_more"
            app:tint="?attr/themeTextMuted"
            android:contentDescription="Conversation actions" />
    </LinearLayout>
</LinearLayout>
