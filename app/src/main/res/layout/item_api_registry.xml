<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento API row card (2026-11-05 bento-all): transparent MaterialCardView shell (kept for code),
     inner bg_set_card_md card, pill badges, plates instead of HUD boxes, pill action buttons. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardApiItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_set_card_md"
        android:padding="16dp">

        <!-- COLLAPSED HEADER (Always Visible) -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Category & Status Dot -->
            <View
                android:id="@+id/dotStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_bento_x_api_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCategoryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_set_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Aviation"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvAuthBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_set_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="100% Free"
                        android:textColor="?attr/themeSuccess"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvApiName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="OpenSky &amp; Community ADS-B Flights"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/tvApiShortSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Worldwide civilian aircraft transponders, altitude &amp; heading"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Status Indicator / Latency -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvPingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="?attr/themeAccent"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/btnToggleDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_set_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Details ▾"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="500" />
            </LinearLayout>
        </LinearLayout>

        <!-- EXPANDABLE DETAIL CONTAINER (Visible only when expanded) -->
        <LinearLayout
            android:id="@+id/layoutDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Hindi Explanation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What it does"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/tvDetailHindi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Aasman me ud rahe sabhi planes ke transponder signal se unki live position, speed aur altitude track karta hai."
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="2dp" />

                <!-- English Explanation -->
                <TextView
                    android:id="@+id/tvDetailEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Worldwide live surveillance of commercial and private aircraft using Mode-S and 1090MHz ADS-B transponder data."
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Role in Gods Eye View -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="On God's Eye"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/tvGodsEyeRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Draws 3D jet aircraft models, altitude trails and callsigns."
                    android:textColor="?attr/themeTextSecondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <!-- Technical URL & Provider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_jarvis_row_item"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProvider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Provider: OpenSky Network / ADSB.lol"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/tvEndpointUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="https://opensky-network.org/api/states/all?extended=1"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Voice Command -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_row_item"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Say"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/tvVoiceCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="'Jarvis, scan air traffic' ya 'Hawa me ud rahe planes dikhao'"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <!-- Action Buttons: Ping, View Raw Data, Connect to Globe -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestPing"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Ping"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    app:backgroundTint="?attr/themeChipBg"
                    app:cornerRadius="20dp"
                    app:strokeColor="?attr/themePlateBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewRawData"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Raw data"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    app:backgroundTint="?attr/themeChipBg"
                    app:cornerRadius="20dp"
                    app:strokeColor="?attr/themePlateBorder"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectGlobe"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textColor="?attr/themeOnAccent"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    app:backgroundTint="?attr/themeAccentFill"
                    app:cornerRadius="20dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPingResultDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap to verify live server connection"
                android:textColor="?attr/themeTextMuted"
                android:textSize="12sp"
                android:fontFamily="@font/inter" />

            <!-- Collapsible Raw Data Viewer Box -->
            <TextView
                android:id="@+id/tvRawDataBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_bento_x_input"
                android:fontFamily="monospace"
                android:maxLines="10"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:text=""
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
