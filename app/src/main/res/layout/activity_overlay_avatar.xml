<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento overlay avatars (2026-11-05 bento-all): page title + muted subtitle, "Floating avatar" bento card
     (switch, pill mode chips, edge dropdown, size), "Your photo as 3D avatar" bento card, then the avatar
     gallery (WebView, assets/overlay-toys/gallery.html, tiles themed from OverlayAvatarActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayAvatarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="?attr/themeBg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_set_icon_btn"
            android:src="@drawable/ic_set_arrow_left"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Back"
            app:tint="?attr/themeTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overlay avatars"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="26sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Pick the companion shown while Jarvis works."
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Floating avatar card ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_set_card"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_set_icon_tile"
                android:padding="9dp"
                android:src="@drawable/ic_sparkle"
                android:contentDescription="@null"
                app:tint="?attr/themeAccent" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchOverlayEnabled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:minHeight="48dp"
                android:text="Show floating overlay"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="17sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />
        </LinearLayout>

        <!-- Visibility mode: pill chips (label colours set in OverlayAvatarActivity.styleModePills) -->
        <RadioGroup
            android:id="@+id/radioOverlayMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbOverlayWorking"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:button="@null"
                android:background="@drawable/bg_bento_x_sht_radio_pill"
                android:gravity="center"
                android:text="While working"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />

            <RadioButton
                android:id="@+id/rbOverlayAlways"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:button="@null"
                android:background="@drawable/bg_bento_x_sht_radio_pill"
                android:gravity="center"
                android:text="Always on"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="4dp"
            android:text="Dock to an edge - dragging picks the nearest edge."
            android:textColor="?attr/themeTextMuted"
            android:textSize="12sp"
            android:fontFamily="@font/inter" />

        <Spinner
            android:id="@+id/spinnerOverlayEdge"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_bento_x_sht_spinner"
            android:popupBackground="@drawable/bg_set_card_md"
            android:paddingStart="8dp"
            android:paddingEnd="36dp"
            android:entries="@array/overlay_edges"
            android:spinnerMode="dropdown" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Avatar size"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/tvOverlayAvatarSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_set_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="88 dp"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekOverlayAvatarSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:progressTint="?attr/themeAccent"
            android:progressBackgroundTint="?attr/themePlateBorder"
            android:thumbTint="?attr/themeAccent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            android:text="Drag to move, double-tap for task status, long-press to close."
            android:textColor="?attr/themeTextMuted"
            android:textSize="12sp"
            android:fontFamily="@font/inter" />
    </LinearLayout>

    <!-- ===== Custom 3D avatar card (create from photo) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCustom3dAvatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_set_card"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 3D avatar preview plate -->
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_jarvis_icon_square">

                    <ImageView
                        android:id="@+id/ivCustomAvatarPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Custom 3D Avatar" />

                    <TextView
                        android:id="@+id/tvCustomAvatarPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✨"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_set_badge"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:text="3D"
                        android:textColor="?attr/themeTextSecondary"
                        android:textSize="9sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCustomAvatarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3D hologram avatar"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600" />

                    <TextView
                        android:id="@+id/tvCustomAvatarSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Turn any JPG/PNG into a floating 3D avatar"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnUploadCustomAvatar"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_set_chip"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="📸 Upload Image"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnActivateCustomAvatar"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_set_chip"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="✓ Active"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageButton
                    android:id="@+id/btnDeleteCustomAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_bento_set_circle"
                    android:src="@drawable/ic_delete"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Remove 3D Avatar"
                    android:visibility="gone"
                    app:tint="?attr/themeDanger" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Gallery section title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:text="Choose an avatar"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="18sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="1dp"
        android:text="Tap to select. Double-tap the floating avatar for task progress."
        android:textColor="?attr/themeTextMuted"
        android:textSize="13sp"
        android:fontFamily="@font/inter" />

    <WebView
        android:id="@+id/avatarGallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:overScrollMode="never"
        android:scrollbars="none" />
</LinearLayout>
