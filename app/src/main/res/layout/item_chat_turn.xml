<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento pass 2026-11-05 (bento-all): bento bubbles bg_bento_x_chat_bubble_user/ai, 16dp bubble padding.
      One voice-chat turn (ChatAdapter / chat history sheet) - 2026-11-05 redesign:
     muted 11sp timestamp, accent-tinted user bubble right, glass assistant bubble left. Ids unchanged. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:textColor="?attr/themeTextMuted"
        android:textSize="11sp"
        android:fontFamily="@font/inter"
        tools:text="19:45" />

    <LinearLayout
        android:id="@+id/boxUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:background="@drawable/bg_bento_x_chat_bubble_user"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_label_you"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="11sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/tvUserTranscript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp"
            tools:text="Hello JARVIS, how are you?" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boxJarvisMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bento_x_chat_bubble_ai"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_label_jarvis"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="11sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/tvJarvisResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp"
            tools:text="Online and ready. How can I assist you today, Boss?" />
    </LinearLayout>

</LinearLayout>
