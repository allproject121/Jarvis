<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVaultRoot"
    android:layout_width="135dp"
    android:layout_height="170dp"
    android:orientation="vertical"
    android:background="@drawable/bg_set_card_md"
    android:padding="12dp"
    android:layout_marginEnd="10dp"
    android:gravity="top">

    <!-- Top Row: Format Chip & Delete Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvCardFormatBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Built-in"
            android:textColor="?attr/themeAccent"
            android:textSize="10sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:background="@drawable/bg_set_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnCardDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_set_icon_btn"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="?attr/themeDanger"
            android:contentDescription="Delete model"
            android:visibility="gone"
            tools:visibility="visible" />
    </RelativeLayout>

    <!-- Center Icon / Avatar -->
    <TextView
        android:id="@+id/tvCardIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="🌌"
        android:textSize="24sp"
        android:background="@drawable/bg_set_icon_tile"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STARK Core Orb"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- File Size -->
    <TextView
        android:id="@+id/tvCardSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Built-in"
        android:textColor="?attr/themeTextMuted"
        android:textSize="11sp"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Active Indicator Badge -->
    <TextView
        android:id="@+id/tvCardActiveBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Active ✓"
        android:textColor="?attr/themeOnAccent"
        android:textSize="11sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:background="@drawable/bg_bento_x_chip_on"
        android:paddingVertical="4dp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
