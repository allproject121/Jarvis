<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="48dp">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_set_icon_btn"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/themeTextPrimary"
                    android:contentDescription="Back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hands-free control"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="26sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Voice automation for apps and phone settings"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Branding Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="22dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_jarvis_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Jarvis Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Autonomous device control"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="19sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Control WhatsApp, YouTube, and phone settings completely hands-free with your voice."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <!-- Live Status Chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_set_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginTop="14dp">

                    <View
                        android:id="@+id/dotAccessibilityStatus"
                    android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_bento_dot"
                        android:backgroundTint="?attr/themeSuccess" />

                    <TextView
                        android:id="@+id/tvAccessibilityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hands-free service active"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Direct Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="16dp"
                    android:text="Configure Accessibility Service"
                    android:textColor="?attr/themeOnAccent"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:textAllCaps="false"
                    app:cornerRadius="24dp"
                    app:backgroundTint="?attr/themeAccentFill" />
            </LinearLayout>

            <!-- How it works -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="💡"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How it works"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Three steps from voice to action"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>


                <!-- Step 1: Hold the Mic Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_set_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mic_jarvis"
                            app:tint="?attr/themeAccent"
                            android:contentDescription="Mic" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Hold the Microphone Button"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Hold the center mic button or tap the 3D Orb to speak. You don&apos;t need to type or navigate manually."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <!-- Step 2: Ultra-Fast AI Neural Brain -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_set_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_stack_memory"
                            app:tint="?attr/themeAccent"
                            android:contentDescription="Brain" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Gemini 3.8 Live Brain"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Your speech is processed in real time using Google&apos;s latest Gemini 3.8 Live model. It understands context in Hindi, Urdu, English, Hinglish, and regional languages."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <!-- Step 3: Autonomous Device Execution -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_set_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_apps"
                            app:tint="?attr/themeAccent"
                            android:contentDescription="Automation" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Digital Hands on Your Mobile"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Jarvis uses your phone&apos;s built-in Android accessibility service to type messages, tap send, search YouTube, and adjust settings just like your own hands."
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Permissions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="🔐"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Permissions"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Let Jarvis tap and type for you"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Why does Jarvis need Accessibility Permission?"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Android protects other apps from being controlled. For Jarvis to send WhatsApp messages or open YouTube videos on your command, you must grant the Jarvis Accessibility Service permission."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick steps to enable"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="1. Tap the 'Open Accessibility Settings' button below.\n2. Tap 'Downloaded Apps' or 'Installed Services'.\n3. Tap 'Jarvis Accessibility Service'.\n4. Turn the switch ON and tap 'Allow'."
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAccessibilitySettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Open Accessibility Settings"
                    android:textColor="?attr/themeOnAccent"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:textAllCaps="false"
                    app:cornerRadius="24dp"
                    app:backgroundTint="?attr/themeAccentFill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAllPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Grant All System Authorizations"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="24dp"
                    app:backgroundTint="?attr/themeChipBg"
                    app:strokeColor="?attr/themePlateBorder"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- Voice commands -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="🗣️"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voice commands"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Things you can say right away"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp">
<TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 WhatsApp Hands-Free Commands"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• &quot;Send WhatsApp to Rahul saying I will reach in 10 minutes&quot;\n• &quot;Call Mom on WhatsApp&quot;\n• &quot;Make a video call to Priya on WhatsApp&quot;\n• &quot;Delete last message for everyone&quot;"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp">
<TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 YouTube &amp; Music Commands"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• &quot;Play Arijit Singh songs on YouTube&quot;\n• &quot;Search Iron Man highlights on YouTube&quot;\n• &quot;Pause YouTube video&quot; / &quot;Play next song&quot;\n• &quot;Make video fullscreen&quot;"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp">
<TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Phone Hardware &amp; Settings"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• &quot;Turn on flashlight / torch&quot;\n• &quot;Increase volume to 80%&quot; / &quot;Mute sound&quot;\n• &quot;Set brightness to 50%&quot;\n• &quot;Turn on Bluetooth&quot; / &quot;Open Instagram&quot;"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_row_item"
                    android:padding="14dp">
<TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Neural Memory &amp; Daily Life"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• &quot;Remember that my passport is in the blue bag&quot;\n• &quot;Where is my passport?&quot;\n• &quot;What is the weather outside?&quot;\n• &quot;Good morning Jarvis, what is my schedule today?&quot;"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- AI model -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_jarvis_icon_square"
                        android:gravity="center"
                        android:text="✨"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI model"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter"
                            android:textFontWeight="600" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live brain and API keys"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Selected Model: Gemini 3.8 Live"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="The app comes pre-configured with Google's gemini-3.8-live model and embedded release API key. Ultra-low latency voice streaming with immediate responses."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfigureApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Manage API Key &amp; Models"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="24dp"
                    app:backgroundTint="?attr/themeChipBg"
