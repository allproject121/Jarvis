<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento app connectors sheet (2026-11-05 bento-all): page title + live subtitle, search plate,
     pill filter chips (selected = accent fill, set in AppConnectorsBottomSheet.setFilterMode),
     pill actions, connector rows (built in code) as inner plates with 8dp gaps. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bento_x_sheet"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bento_x_handle"
        android:layout_marginBottom="18dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App connectors"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="26sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvConnectorsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Full phone app access &amp; autonomous control"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseConnectors"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_set_icon_btn"
            android:src="@drawable/ic_set_x"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bento_x_input"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_set_search"
            app:tint="?attr/themeTextMuted"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/etSearchConnectors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Search apps (Drive, WhatsApp, Files…)"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextMuted"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Filter chips (backgrounds/text colours swapped in code) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All apps"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:gravity="center"
                android:textColor="?attr/themeOnAccent"
                android:background="@drawable/bg_bento_x_chip_on"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipFilterConnected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Connected"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:gravity="center"
                android:textColor="?attr/themeTextSecondary"
                android:background="@drawable/bg_set_chip"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipFilterDisconnected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Basic"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:gravity="center"
                android:textColor="?attr/themeTextSecondary"
                android:background="@drawable/bg_set_chip"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Actions: Connect all (primary) + Add plugin (plate) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnConnectAllApps"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Connect all"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:textColor="?attr/themeOnAccent"
            app:backgroundTint="?attr/themeAccentFill"
            app:cornerRadius="22dp" />

        <Button
            android:id="@+id/btnAddExternalConnector"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Add plugin"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:textColor="?attr/themeTextPrimary"
            app:backgroundTint="?attr/themeChipBg"
            app:strokeColor="?attr/themePlateBorder"
            app:strokeWidth="1dp"
            app:cornerRadius="22dp" />
    </LinearLayout>

    <!-- Token-based cloud services (Notion, Linear, Todoist, GitLab, Drive, Vercel, Telegram, GitHub) -->
    <Button
        android:id="@+id/btnServiceConnectors"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Service connectors · Notion, Drive, Telegram…"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600"
        android:textColor="?attr/themeTextPrimary"
        android:maxLines="1"
        android:ellipsize="end"
        app:backgroundTint="?attr/themeChipBg"
        app:strokeColor="?attr/themePlateBorder"
        app:strokeWidth="1dp"
        app:cornerRadius="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:text="Installed apps"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:textFontWeight="600" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutConnectorsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
