<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant name dialog - Dark Bento (2026-11-05 bento-all): bento card, icon plate + 19sp title,
     preset pills, rounded input plate, ghost + accent pill buttons. Ids/types unchanged.
     (Selected preset styling is applied in SettingsFragment.updateChips.) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_card"
    android:padding="20dp">

    <!-- Header: icon plate + title + subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_set_icon_tile">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit"
                app:tint="?attr/themeAccent"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assistant name"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="19sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pick a preset call-sign or type your own"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>
    </LinearLayout>

    <!-- Preset pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/btnDialogChipJarvis"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="JARVIS"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:maxLines="1"
            android:background="@drawable/bg_set_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnDialogChipFriday"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="FRIDAY"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:maxLines="1"
            android:background="@drawable/bg_set_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnDialogChipEdith"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="EDITH"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:maxLines="1"
            android:background="@drawable/bg_set_chip"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Custom name input plate -->
    <EditText
        android:id="@+id/etDialogAssistantName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_bento_x_input"
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextMuted"
        android:textSize="15sp"
        android:fontFamily="@font/inter"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:hint="e.g. JARVIS"
        android:layout_marginBottom="20dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:background="@drawable/bg_set_chip"
            app:backgroundTint="@null"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Save name"
            android:textAllCaps="false"
            android:textColor="?attr/themeOnAccent"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:background="@drawable/bg_jarvis_pill_button"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
