<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_card"
    android:padding="20dp">

    <!-- Header Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CORE IDENTIFIER"
            android:textColor="?attr/themeAccent"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_jarvis_status_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="?attr/themeCardBorder"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure Assistant Name"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a quick call-sign preset or enter a custom name below:"
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp"
        android:layout_marginBottom="14dp" />

    <!-- Quick Call-Sign Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnDialogChipJarvis"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="JARVIS"
            android:textColor="?attr/themeTextPrimary"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:background="@drawable/bg_jarvis_row_item"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnDialogChipJarvisCompanion"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="JARVIS"
            android:textColor="?attr/themeAccent"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:background="@drawable/bg_jarvis_chip"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnDialogChipFriday"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="FRIDAY"
            android:textColor="?attr/themeTextPrimary"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:background="@drawable/bg_jarvis_row_item"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnDialogChipEdith"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="EDITH"
            android:textColor="?attr/themeTextPrimary"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:background="@drawable/bg_jarvis_row_item"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Custom Name Input -->
    <EditText
        android:id="@+id/etDialogAssistantName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_jarvis_input_field"
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextMuted"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:hint="e.g. JARVIS or JARVIS"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="CANCEL"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_jarvis_row_item"
            android:backgroundTint="@null"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:text="CONFIRM &amp; SAVE"
            android:textColor="#070914"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_jarvis_pill_button"
            android:backgroundTint="?attr/themeAccent" />
    </LinearLayout>

</LinearLayout>
