<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API &amp; Connection"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini Live WebSocket &amp; Engine"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Connection Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_jarvis_mic_center"
                        android:backgroundTint="@color/status_green" />

                    <TextView
                        android:id="@+id/tvLiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE • READY"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginStart="8dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvPingResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ping: -- ms"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEndpointSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="wss://generativelanguage.googleapis.com (Gemini 2.0 Live Protocol)"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestConnection"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    app:strokeColor="?attr/themeAccent"
                    app:strokeWidth="1dp"
                    android:text="Test Connection &amp; Latency"
                    android:textColor="?attr/themeAccent"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp"
                    app:icon="@drawable/ic_settings_wave"
                    app:iconSize="16dp"
                    app:iconTint="?attr/themeAccent" />
            </LinearLayout>

            <!-- Card 2: Gemini API Key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Credentials"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemini API Key"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direct authorization key from Google AI Studio"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="?attr/themeAccent"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="AIzaSy..."
                        android:inputType="textPassword"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteKey"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        app:strokeColor="?attr/themeAccent"
                        app:strokeWidth="1dp"
                        android:text="Paste Clipboard"
                        android:textColor="?attr/themeAccent"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearKey"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        app:strokeColor="?attr/themeTextMuted"
                        app:strokeWidth="1dp"
                        android:text="Clear"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: AI Model Engine -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model Engine"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgModelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_jarvis_card"
                android:padding="14dp"
                android:layout_marginBottom="18dp">

                <RadioButton
                    android:id="@+id/rbModelFlashThinking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="gemini-3.1-flash (Ultra-Low Latency Live • ~700ms Recommended)"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/themeCardBorder" />

                <RadioButton
                    android:id="@+id/rbModelFlash20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="gemini-3.8-live (Flagship Conversational Intelligence)"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />



                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/themeCardBorder" />

                <RadioButton
                    android:id="@+id/rbModelFlash15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="gemini-3.1-flash (Balanced Multi-Model Autonomous Agent)"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </RadioGroup>

            <!-- Card 4: Custom WebSocket Endpoint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Endpoint (Optional)"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Local Host AI Core (Ollama / Windows PC)"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Execute local offline intelligence from your laptop over Wi-Fi (LAN) or USB ADB Reverse"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />

                <!-- Endpoint URL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="?attr/themeAccent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomEndpoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="http://192.168.0.101:11434"
                        android:inputType="textUri"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Model Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="?attr/themeAccent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLocalHostModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Model (e.g. qwen3.8:27b)"
                        android:inputType="text"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Preset Quick Fill Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFillWifi"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        app:strokeColor="?attr/themeAccent"
                        app:strokeWidth="1dp"
                        android:text="Home Wi-Fi PC"
                        android:textColor="?attr/themeAccent"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFillAdb"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        app:strokeColor="?attr/themeTextMuted"
                        app:strokeWidth="1dp"
                        android:text="USB ADB (Loopback)"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Test Connection Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestLocalHost"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="⚡ TEST PC OLLAMA CONNECTION"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0284C7"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <!-- Status Feedback -->
                <TextView
                    android:id="@+id/tvLocalHostStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Ready to connect to Ollama"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Card 4: God's Eye 3D Sensors & Satellite Feeds -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_jarvis_card"
                android:padding="18dp"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GOD'S EYE 3D SENSORS &amp; SATELLITE FEEDS"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPTIONAL"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unlock full photorealistic 3D tiles, real-time satellite wildfires, cargo vessel tracking, and live traffic flow. Tap 'GET KEY' to obtain your free access keys."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp" />

                <!-- 1. Google 3D Tiles Key -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Google Photorealistic 3D Tiles"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetGoogleKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GET KEY ↗"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeGoogleKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="AIzaSy... (Google Maps API Key)"
                        android:inputType="textPassword"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Cesium Ion Token -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cesium Ion Token (Terrain &amp; Buildings)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetCesiumToken"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GET TOKEN ↗"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeCesiumToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="eyJhbG... (Cesium Ion Default Access Token)"
                        android:inputType="textPassword"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. NASA FIRMS Active Wildfires -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NASA FIRMS (Active Wildfires)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetFirmsKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GET FREE KEY ↗"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeFirmsKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="NASA FIRMS Map Key (32 hex characters)"
                        android:inputType="text"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 4. AISStream Live Marine Ships -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="AISStream (Live Marine &amp; Cargo Ships)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetAisStreamKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GET FREE KEY ↗"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeAisStreamKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="AISStream API Key"
                        android:inputType="text"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 5. TomTom Live Traffic Flow -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TomTom Traffic (Live Congestion)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetTomTomKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GET FREE KEY ↗"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeTomTomKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="TomTom API Key"
                        android:inputType="text"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 6. Mapillary Street-Level Imagery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mapillary (360° Street-Level Views)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetMapillaryToken"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="GET TOKEN ↗"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeMapillaryToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="MLY|... (Mapillary Client Token)"
                        android:inputType="text"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 7. OpenSky Network Air Traffic -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OpenSky Network (Extended Air Traffic)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetOpenSkyKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="REGISTER ↗"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeOpenSkyClientId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="OpenSky Client ID / Username"
                        android:inputType="text"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGodsEyeOpenSkyClientSecret"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="OpenSky Client Secret / Password"
                        android:inputType="textPassword"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- 5. SMART HOME & IOT ENGINE (HOME ASSISTANT / WEBHOOKS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_jarvis_row_item"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMART HOME &amp; IOT (HOME ASSISTANT / WEBHOOKS)"
                    android:textColor="?attr/themeAccent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Control smart lights, switches, fans, and scenes directly through voice commands. Connect to a local or cloud Home Assistant instance, or provide an HTTP Webhook (IFTTT, n8n, Node-RED)."
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp" />

                <!-- Home Assistant URL -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHomeAssistantUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Home Assistant URL (e.g. http://192.168.1.100:8123)"
                        android:inputType="textUri"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Home Assistant Long-Lived Access Token -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHomeAssistantToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Long-Lived Access Token (Bearer)"
                        android:inputType="textPassword"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Webhook Fallback URL -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="?attr/themeAccent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSmartHomeWebhookUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Optional Webhook URL (IFTTT / n8n / Local)"
                        android:inputType="textUri"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Test IoT Connection Button -->
                <Button
                    android:id="@+id/btnTestSmartHomeApi"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:text="TEST IOT / HA CONNECTION"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSmartHomeApiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="IoT Status: Ready"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Save Action Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="?attr/themeBg"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveConnection"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_jarvis_pill_button"
            app:backgroundTint="@null"
            android:text="Save &amp; Apply Configuration"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
