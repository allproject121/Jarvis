<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Bento pass 2026-11-05 (bento-all): bento bubbles bg_bento_x_chat_bubble_user/ai, 16dp bubble padding.
      Simple Jarvis chat message (2026-11-05 redesign: glass assistant bubble, accent-tinted user
     bubble, ghost action icons). Ids unchanged. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- User message (right) -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingStart="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:background="@drawable/bg_bento_x_chat_bubble_user"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="Hi"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnUserEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_edit"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Edit" />

            <ImageView
                android:id="@+id/btnUserCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy" />
        </LinearLayout>
    </LinearLayout>

    <!-- Assistant message (left) -->
    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_set_icon_tile">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkle"
                    app:tint="?attr/themeAccent"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Jarvis"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="310dp"
            android:background="@drawable/bg_bento_x_chat_bubble_ai"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Online and ready. How can I help?"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnAssistantCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Copy" />

            <ImageView
                android:id="@+id/btnAssistantPlay"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="7dp"
                android:background="@drawable/bg_set_ghost_circle"
                android:src="@drawable/ic_tts_play"
                app:tint="?attr/themeTextMuted"
                android:contentDescription="Play" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
