<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGodsEyeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- Primary Hardware-Accelerated Cesium WebGL WebView -->
    <WebView
        android:id="@+id/webViewGodsEye"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layerType="hardware"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sleek Floating HUD Header Overlay -->
    <LinearLayout
        android:id="@+id/topBarGodsEye"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Return to JARVIS" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOD'S EYE VIEW"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_jarvis_status_badge_green"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvStatusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL NODE • 127.0.0.1:4173"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_nav_home"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Reload Globe" />
    </LinearLayout>

    <!-- Loading State Overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_futuristic"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/themeAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting to God's Eye Console&#8230;"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading Cesium 3D Globe &amp; Live Data"
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Error & Recovery Card Overlay -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_jarvis_error_card"
        android:padding="22dp"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_warning"
            app:tint="?attr/themeAccent"
            android:contentDescription="Server Offline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="God's Eye Console Offline"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Could not connect to http://127.0.0.1:4173/.\n\nPlease ensure the background server is running in Termux:\ncd ~/gods-eye-view\nnpm run preview -- --host 127.0.0.1 --port 4173"
            android:textColor="?attr/themeTextMuted"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnErrorBack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Back"
                android:textColor="?attr/themeTextPrimary"
                android:background="@drawable/bg_jarvis_action_card"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Retry"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_jarvis_pill_button"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
