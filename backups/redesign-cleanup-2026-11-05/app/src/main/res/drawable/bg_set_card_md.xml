<?xml version="1.0" encoding="utf-8"?>
<!-- Smaller-radius hairline card (16dp) for bars, stat tiles and the empty state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="?attr/themeCardGlassStart"
        android:endColor="?attr/themeCardGlassEnd" />
    <stroke
        android:width="1dp"
        android:color="?attr/themeCardBorder" />
</shape>
