<?xml version="1.0" encoding="utf-8"?>
<!-- Settings/Chat redesign (2026-11-05): shadcn-style card - 20dp radius, glass fill, 1dp hairline border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="?attr/themeCardGlassStart"
        android:endColor="?attr/themeCardGlassEnd" />
    <stroke
        android:width="1dp"
        android:color="?attr/themeCardBorder" />
</shape>
