<?xml version="1.0" encoding="utf-8"?>
<!-- Nova home (2026-11-05): shadcn-style bento card. 20dp radius, hairline border, glass fill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="?attr/themeCardGlassStart"
                android:endColor="?attr/themeCardGlassEnd" />
            <stroke
                android:width="1dp"
                android:color="?attr/themeCardBorder" />
        </shape>
    </item>
</ripple>
