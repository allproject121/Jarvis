<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Filter chips of the Chat tab conversation drawer (Jarvis chip look). -->
    <style name="JarvisChatDrawerChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_jarvis_chip</item>
        <item name="android:textColor">?attr/themeTextPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
