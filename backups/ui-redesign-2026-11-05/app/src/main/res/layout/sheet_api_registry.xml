<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/themeBg"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="?attr/themeCardBorder" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLANETARY SENSOR &amp; API HUB"
                    android:textColor="?attr/themeAccent"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvTotalApiCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/themeChipBg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="24 FEEDS"
                    android:textColor="?attr/themeAccent"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="All repo intelligence APIs, endpoints &amp; live test diagnostics"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Test All Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPingAllApis"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="?attr/themeChipBg"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="⚡ PING ALL"
            android:textColor="?attr/themeAccent"
            android:textSize="10sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:strokeColor="?attr/themeAccent"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Category Filter Chips (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:checked="true"
                android:text="ALL (24)"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeChipBg"
                app:chipStrokeColor="?attr/themeAccent"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAviation"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="AVIATION"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeCardBg"
                app:chipStrokeColor="?attr/themeCardBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCctv"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="CCTV"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeCardBg"
                app:chipStrokeColor="?attr/themeCardBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSpace"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="SPACE"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeCardBg"
                app:chipStrokeColor="?attr/themeCardBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeather"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="WEATHER"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeCardBg"
                app:chipStrokeColor="?attr/themeCardBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSeismic"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="SEISMIC"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeCardBg"
                app:chipStrokeColor="?attr/themeCardBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDefense"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="DEFENSE"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeCardBg"
                app:chipStrokeColor="?attr/themeCardBorder"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAudio"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="AUDIO"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="11sp"
                app:chipBackgroundColor="?attr/themeCardBg"
                app:chipStrokeColor="?attr/themeCardBorder"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Search / Filter Box -->
    <EditText
        android:id="@+id/etSearchApis"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_themed_detail_box"
        android:hint="Search APIs by name, domain or keyword..."
        android:textColorHint="?attr/themeTextMuted"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="12sp"
        android:paddingHorizontal="12dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:singleLine="true"
        android:layout_marginBottom="10dp" />

    <!-- RecyclerView for API items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
