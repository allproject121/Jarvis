<?xml version="1.0" encoding="utf-8"?>
<!-- Maya card, selected: accent border + faint accent wash. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/themeAccentLight">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="?attr/themeCardBg" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="?attr/themeAccentLight" />
                    <stroke android:width="1.5dp" android:color="?attr/themeAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
