<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGodsEyeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- Primary Fullscreen Hardware-Accelerated Cesium WebGL WebView -->
    <WebView
        android:id="@+id/webViewGodsEye"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layerType="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Minimalist Floating Cyber HUD Top Toolbar -->
    <LinearLayout
        android:id="@+id/layoutTopHudToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_bento_x_misc_float_btn"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Return to JARVIS" />

        <ImageButton
            android:id="@+id/btnApiHub"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bento_x_misc_float_btn"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_code_chip"
            android:padding="10dp"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Open Gods Eye Direct API Hub" />

        <ImageButton
            android:id="@+id/btnOrientationToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bento_x_misc_float_btn"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_screen_rotate"
            android:padding="10dp"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Toggle Screen Orientation (Widescreen Tactical HUD)" />

        <ImageButton
            android:id="@+id/btnHeroScene"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bento_x_misc_float_btn"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hero_target"
            android:padding="10dp"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Hero Demo Mode (Arizona Pinal Airpark Cockpit Follow)" />

        <ImageButton
            android:id="@+id/btnAutoTour"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bento_x_misc_float_btn"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_auto_cycle"
            android:padding="10dp"
            app:tint="?attr/themeAccent"
            android:contentDescription="Toggle Auto Sentinel Tour" />

        <!-- Cyber HUD Auto-Tour Active Status Pill -->
        <LinearLayout
            android:id="@+id/layoutAutoTourHud"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bento_x_misc_float_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAutoTourBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:drawableStart="@drawable/bg_bento_dot"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="Auto: flights (14s)"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnAutoTourNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_bento_x_chip_on"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Next"
                android:textColor="?attr/themeOnAccent"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden reload button for programmatic / legacy access -->
    <ImageButton
        android:id="@+id/btnReload"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Cyber HUD Loading State Overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_jarvis_card"
        android:paddingHorizontal="28dp"
        android:paddingVertical="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/themeAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting to God's Eye…"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="16sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading the 3D globe and map layers"
            android:textColor="?attr/themeTextMuted"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Cyber HUD Error & Recovery Card Overlay -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_jarvis_card"
        android:padding="20dp"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_warning"
            app:tint="?attr/themeDanger"
            android:contentDescription="Server Offline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="God's Eye Console Offline"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="19sp"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Could not connect to http://localhost:4173/.\n\nPlease ensure the background server is running in Termux:\ncd ~/gods-eye-view\nnpm run preview -- --host localhost --port 4173"
            android:textColor="?attr/themeTextMuted"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnErrorBack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Back"
                android:textAllCaps="false"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:textColor="?attr/themeTextPrimary"
                android:background="@drawable/bg_set_chip"
                app:backgroundTint="@null"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Retry"
                android:textAllCaps="false"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:textColor="?attr/themeOnAccent"
                android:background="@drawable/bg_jarvis_pill_button"
                app:backgroundTint="@null"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
