<?xml version="1.0" encoding="utf-8"?>
<!-- Nova dock: active tab = white-glass pill with a hairline border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#24FFFFFF"
        android:endColor="#12FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="?attr/themeCardBorder" />
</shape>
