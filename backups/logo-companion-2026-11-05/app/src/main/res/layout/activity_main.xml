<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="?attr/themeBg">

    <!-- Fragment Container for Home, Chat, Settings, and Updates -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Nova dock (2026-11-05): floating glass pill, 64dp tall, 20dp side margins.
        Centre mic = raised circular button with an accent glow ring (backgrounds swapped from
        MainActivity: bg_nova_mic_on / _off / _muted). Active tab = white-glass pill with label
        (bg_nova_dock_active, set from MainActivity.updateDockUI); inactive = icon + muted label.
        Bottom margin is raised by the navigation-bar inset from MainActivity.
    -->
    <FrameLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_nova_dock"
        android:elevation="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Soft glow that slides under the active tab (moved/tinted by MainActivity.moveLumaSpotlight) -->
        <ImageView
            android:id="@+id/ivLumaSpotlight"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/bg_nova_dock_spotlight"
            android:scaleType="fitXY"
            android:alpha="0.85"
            android:importantForAccessibility="no" />

        <!-- Tiny grab handle (tap to collapse into the compact island) -->
        <View
            android:id="@+id/btnToggleDockMode"
            android:layout_width="28dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nova_dock_handle"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Collapse dock" />

        <!-- Expanded 5-tab row -->
        <LinearLayout
            android:id="@+id/dockTabsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Tab 1: Home -->
            <FrameLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabHome"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:minWidth="54dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_nova_dock_active">

                    <ImageView
                        android:id="@+id/ivTabHome"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_home"
                        app:tint="?attr/themeTextPrimary"
                        android:contentDescription="Home" />

                    <TextView
                        android:id="@+id/tvTabHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Home"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textColor="?attr/themeTextPrimary" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 2: Chat -->
            <FrameLayout
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabChat"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:minWidth="54dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/ivTabChat"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_chat"
                        app:tint="?attr/themeTextMuted"
                        android:contentDescription="Chat" />

                    <TextView
                        android:id="@+id/tvTabChat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Chat"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textColor="?attr/themeTextMuted" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 3: Voice / Mic (raised circular hero button) -->
            <FrameLayout
                android:id="@+id/tabMic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Talk to Jarvis">

                <LinearLayout
                    android:id="@+id/pillTabMic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:translationY="-16dp"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_nova_mic_off">

                    <ImageView
                        android:id="@+id/ivTabMic"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_mic_jarvis"
                        app:tint="?attr/themeTextPrimary"
                        android:contentDescription="Voice" />

                    <TextView
                        android:id="@+id/tvTabMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:includeFontPadding="false"
                        android:textColor="?attr/themeTextPrimary"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 4: God's Eye -->
            <FrameLayout
                android:id="@+id/tabGodsEye"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabGodsEye"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:minWidth="54dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivTabGodsEye"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_gods_eye"
                        app:tint="?attr/themeTextMuted"
                        android:contentDescription="God's Eye" />

                    <TextView
                        android:id="@+id/tvTabGodsEye"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="God's Eye"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textColor="?attr/themeTextMuted" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab: AI Hub (embedded AndroLLM Compose UI, same Activity) -->
            <FrameLayout
                android:id="@+id/tabAiHub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabAiHub"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:minWidth="54dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/ivTabAiHub"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_androllm_layers"
                        app:tint="?attr/themeTextMuted"
                        android:contentDescription="AI Hub" />

                    <TextView
                        android:id="@+id/tvTabAiHub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="AI Hub"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textColor="?attr/themeTextMuted" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 5: Settings -->
            <FrameLayout
                android:id="@+id/tabMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/pillTabMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:minWidth="54dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/ivTabMenu"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="?attr/themeTextMuted"
                        android:contentDescription="Settings" />

                    <TextView
                        android:id="@+id/tvTabMenu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Settings"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/inter"
                        android:textFontWeight="500"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:textColor="?attr/themeTextMuted" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- Compact island (shown when the dock is collapsed) -->
        <LinearLayout
            android:id="@+id/layoutCompactIsland"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Expand dock">

            <View
                android:id="@+id/ivIslandPulseDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_nova_dot"
                android:backgroundTint="?attr/themeAccent" />

            <TextView
                android:id="@+id/tvIslandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Jarvis"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:textColor="?attr/themeTextPrimary" />

            <ImageView
                android:id="@+id/ivIslandMic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:padding="7dp"
                android:background="@drawable/bg_nova_icon_chip"
                android:src="@drawable/ic_mic_jarvis"
                app:tint="?attr/themeAccent"
                android:contentDescription="Talk to Jarvis" />
        </LinearLayout>

    </FrameLayout>

    <!-- Legacy arch line over the old mic (hidden in the Nova dock; kept for code references) -->
    <com.jarvis.assistant.ui.widget.CurvedDockLineView
        android:id="@+id/dockCurvedLine"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:elevation="14dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/bottomDock"
        app:layout_constraintEnd_toEndOf="@id/bottomDock"
        app:layout_constraintTop_toTopOf="@id/bottomDock"
        android:layout_marginTop="-21dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
