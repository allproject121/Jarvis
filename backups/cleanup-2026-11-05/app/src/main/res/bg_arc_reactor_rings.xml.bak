    <!-- Center Ambient Glow -->
    <path
        android:fillColor="#1500F0FF"
        android:pathData="M140,140m-90,0a90,90 0,1,1 180,0a90,90 0,1,1 -180,0" />

    <!-- Outer Telemetry Ring -->
    <path
        android:strokeColor="#2200F0FF"
        android:strokeWidth="1.2"
        android:pathData="M140,140m-130,0a130,130 0,1,1 260,0a130,130 0,1,1 -260,0" />

    <!-- Secondary Ring with Dash pattern simulation -->
