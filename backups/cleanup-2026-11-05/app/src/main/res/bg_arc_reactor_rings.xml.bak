    <path
        android:strokeColor="#5000F0FF"
        android:strokeWidth="1.5"
        android:pathData="M232,48 L222,48 M232,48 L232,58" />
    <path
        android:strokeColor="#5000F0FF"
        android:strokeWidth="1.5"
        android:pathData="M48,232 L58,232 M48,232 L48,222" />
    <path
        android:strokeColor="#5000F0FF"
        android:strokeWidth="1.5"
        android:pathData="M232,232 L222,232 M232,232 L232,222" />

    <!-- 4 Cardinal Orbit Indicator Dots -->
    <path
